{
    "name": "oscaraccountant/sdk",
    "description": "The PHP SDK of the Oscar accounting API.",
    "type": "library",
    "keywords": ["oscar", "accounting", "api", "sdk", "estonia", "invoices"],
    "homepage": "https://oscaraccountant.com",
    "license": "MIT",
    "authors": [
        {
            "name": "OscarAI OÜ",
            "homepage": "https://oscaraccountant.com"
        }
    ],
    "support": {
        "issues": "https://github.com/oscaraccountant/oscaraccountant-php/issues",
        "source": "https://github.com/oscaraccountant/oscaraccountant-php"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.10",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "suggest": {
        "psr/http-client": "To send the requests through your own PSR-18 HTTP client",
        "psr/http-factory": "To build the requests with your own PSR-17 factories"
    },
    "autoload": {
        "psr-4": {
            "OscarAccountant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OscarAccountant\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
